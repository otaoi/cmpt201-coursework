#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <stbool.h>


int main() {
  char *buff = NULL;
  char *token;
  char *saveptr;
  char *delimt = " ";
  size_t size = 0;
  printf("Lemme get ur line: ");
  ssize_t readline = getline(&buff, &size, stdin);
  if (readline == -1) {
    free(buff);
    perror("getline did not work");
    exit(EXIT_FAILURE);
  }
  free(buff);

  while (true){
    token = strtok_r(&readline, &delimt, &saveptr)
    if (token == NULL){ break;}
    printf("%s", token);
    
  







  }


}
